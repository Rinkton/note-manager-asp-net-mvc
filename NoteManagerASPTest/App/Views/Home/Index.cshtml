@{
    ViewData["Title"] = "Note Manager";
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <style>
        body {
            font-family: sans-serif;
            max-width: 500px;
            margin: 20px auto;
        }

        .note-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 6px 10px;
            border-bottom: 1px solid #ddd;
        }

        .note-text {
            flex-grow: 1;
            word-break: break-word;
        }

        .del-btn {
            margin-left: 12px;
            cursor: pointer;
            background: none;
            border: none;
            color: #c00;
            font-size: 16px;
        }

            .del-btn:hover {
                color: #800;
            }

        .add-bar {
            display: flex;
            margin-top: 16px;
            gap: 6px;
        }

            .add-bar input {
                flex-grow: 1;
                padding: 6px;
            }

        button {
            cursor: pointer;
        }
    </style>
</head>
<body>

    <h3>Мои записи</h3>

    <!-- Список записей -->
    <div id="notes-list">
        @foreach(var note in Model) {
            <div>@note.Text</div>
        }
    </div>

    <!-- Блок добавления -->
    <div class="add-bar">
        <form asp-controller="Home" asp-action="SubmitForm" method="post">
            <input type="text" name="noteText" placeholder="Новая запись...">
            <button id="add-btn" type="submit" class="btn btn-primary">Добавить</button>
        </form>
    </div>

</body>
</html>
